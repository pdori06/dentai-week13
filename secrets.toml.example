# secrets.toml.example — 이 파일은 '예시'라서 GitHub 에 올려도 됩니다(실제 값 없음).
#
# [로컬] 이 파일을 복사해 같은 폴더에 secrets.toml 을 만들고 값을 채우세요.
#        Windows:  copy .streamlit\secrets.toml.example .streamlit\secrets.toml
#        Mac:      cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#        secrets.toml 은 .gitignore 에 들어 있어 commit 되지 않습니다.
# [클라우드] 아래 내용을 Advanced settings → Secrets 칸에 붙여넣고 값을 채우세요.
#
# 모든 항목은 선택입니다. 아무것도 없으면 PROVIDER=mock 으로 실행됩니다.

# mock | openai | ollama  (클라우드에는 Ollama 가 없으므로 openai 또는 mock)
PROVIDER = "mock"

# OpenAI 를 쓸 때만(수업에서는 쓰지 않음). 키는 절대 GitHub 에 올리지 마세요.
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o-mini"
# (선택) 학교 프록시 등 OpenAI 호환 서버 주소. 로컬에서 키 없이 openai 경로를 연습하려면
#        Ollama 주소 + OPENAI_MODEL = "qwen2.5:1.5b" + 키는 아무 문자열(예: "ollama")
# OPENAI_BASE_URL = "http://127.0.0.1:11434/v1"

# 로컬 Ollama 를 쓸 때만(선택). 기본값 그대로면 적지 않아도 됩니다.
# OLLAMA_URL = "http://127.0.0.1:11434"
# OLLAMA_MODEL = "qwen2.5:1.5b"

# 공개 URL 보호용 접속 비밀번호(비워 두면 비밀번호 없이 접속)
APP_PASSWORD = "dmdel523"

# 브라우저 세션 하나당 LLM 호출 최대 횟수
MAX_CALLS_PER_SESSION = 20
